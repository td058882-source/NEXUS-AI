# API keys: guárdalas como variables privadas en el servidor, nunca en GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Ollama solo funciona si el servidor NEXUS puede acceder a tu Ollama local.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
PORT=3000
