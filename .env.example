# Copia este archivo como .env y pega aquí las claves API que ya tienes configuradas.
# .env está excluido de Git: nunca subas claves a GitHub ni las pegues en el chat.
# Los proveedores de pago siguen bloqueados salvo que cambies NEXUS_ALLOW_PAID_PROVIDERS=true.
NEXUS_ALLOW_PAID_PROVIDERS=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_BASE_URL=https://api.together.ai/v1

FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Anthropic y Cohere tienen endpoints específicos/compatibles; sus claves pueden requerir saldo o prueba.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com

COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

# Cloudflare Workers AI: también activa la generación de imágenes FLUX en NEXUS.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_CHAT_MODEL=@cf/google/gemma-4-26b-a4b-it

# En Docker Compose, Ollama se configura automáticamente en http://ollama:11434.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_API_KEY=

# LocalAI permanece apagado para no consumir los recursos limitados del Chromebook.
LOCALAI_ENABLED=false
LOCALAI_BASE_URL=http://localai:8080
LOCALAI_MODEL=gpt-4
LOCALAI_API_KEY=

PORT=3000
